{
  "name": "WF-10 Facebook Publishing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "facebook/publish",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1b7c9ade-0001-4a3b-9c1d-000000000b01",
      "name": "FB Publish Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "fug-fb-publish"
    },
    {
      "parameters": {
        "jsCode": "// WF-10: approval gate (same policy as WF-08/WF-09).\nconst j = $input.first().json;\nconst auto = String($env.AUTO_PUBLISH || 'false') === 'true';\nconst approved = j.approval_status === 'APPROVED' || j.approved === true;\nif (!approved && !auto) {\n  return [{ json: { ...j, __skip: true, __reason: 'APPROVAL_REQUIRED' } }];\n}\nreturn [{ json: { ...j, __skip: false } }];"
      },
      "id": "1b7c9ade-0002-4a3b-9c1d-000000000b02",
      "name": "Approval Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.META_PAGE_ID }}/feed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.META_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": $json.message,\n  \"link\": $json.link\n}",
        "options": {}
      },
      "id": "1b7c9ade-0003-4a3b-9c1d-000000000b03",
      "name": "FB Create Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// WF-10: capture post id for tracking + reporting.\nconst j = $('Approval Gate').first().json;\nconst post = $input.first()?.json || {};\nreturn [{ json: {\n  ...j,\n  platform: 'facebook',\n  platform_post_id: post.id || null,\n  status: post.id ? 'PUBLISHED' : 'FAILED',\n  note: 'Scaffold: save to SocialPosts table when Meta credentials are live.',\n} }];"
      },
      "id": "1b7c9ade-0004-4a3b-9c1d-000000000b04",
      "name": "Capture Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": $json.status,\n  \"platform_post_id\": $json.platform_post_id,\n  \"skipped\": $json.__skip || false\n}",
        "options": {}
      },
      "id": "1b7c9ade-0005-4a3b-9c1d-000000000b05",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 0]
    }
  ],
  "connections": {
    "FB Publish Webhook": {
      "main": [[{ "node": "Approval Gate", "type": "main", "index": 0 }]]
    },
    "Approval Gate": {
      "main": [[{ "node": "FB Create Post", "type": "main", "index": 0 }]]
    },
    "FB Create Post": {
      "main": [[{ "node": "Capture Result", "type": "main", "index": 0 }]]
    },
    "Capture Result": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false },
  "active": false
}

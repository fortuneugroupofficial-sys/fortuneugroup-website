{
  "name": "WF-10 Facebook Publishing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "facebook/publish",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "1b7c9ade-0001-4a3b-9c1d-000000000b01",
      "name": "FB Publish Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "fug-fb-publish"
    },
    {
      "parameters": {
        "jsCode": "// WF-10: APPROVAL GATE (same policy as WF-08/WF-09).\nconst j = $input.first().json;\nconst auto = String($vars.AUTO_PUBLISH || 'false') === 'true';\nconst approved = j.approval_status === 'APPROVED' || j.approved === true;\nif (!approved && !auto) {\n  return [{ json: { ...j, __skip: true, __reason: 'APPROVAL_REQUIRED', status: 'BLOCKED' } }];\n}\nreturn [{ json: { ...j, __skip: false, status: 'PUBLISHING' } }];"
      },
      "id": "1b7c9ade-0002-4a3b-9c1d-000000000b02",
      "name": "Approval Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $vars.META_PAGE_ID }}/feed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $credentials.fortuneMeta }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": ($json.message || $json.caption || ''),\n  \"link\": $json.link\n}",
        "options": {}
      },
      "id": "1b7c9ade-0003-4a3b-9c1d-000000000b03",
      "name": "FB Create Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// WF-10: capture post id.\nconst gate = $('Approval Gate').first().json;\nif (gate.__skip) return [{ json: { ...gate, platform_post_id: null, url: null } }];\nconst post = $input.first()?.json || {};\nconst id = post.id || null;\nreturn [{ json: {\n  ...gate,\n  platform: 'facebook',\n  platform_post_id: id,\n  url: id ? ('https://www.facebook.com/' + id) : null,\n  status: id ? 'PUBLISHED' : 'FAILED',\n} }];"
      },
      "id": "1b7c9ade-0004-4a3b-9c1d-000000000b04",
      "name": "Capture Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOCODB_URL }}/api/v2/tables/{{ $env.NOCODB_SOCIALPOSTS_TABLE_ID }}/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content_id\": $json.content_id,\n  \"platform\": \"facebook\",\n  \"platform_post_id\": $json.platform_post_id,\n  \"url\": $json.url,\n  \"title\": $json.title,\n  \"status\": $json.status,\n  \"published_at\": ($json.status === 'PUBLISHED' ? new Date().toISOString() : null)\n}",
        "options": {}
      },
      "id": "1b7c9ade-0005-4a3b-9c1d-000000000b05",
      "name": "Save SocialPost",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOCODB_URL }}/api/v2/tables/{{ $env.NOCODB_AUTOMATIONLOGS_TABLE_ID }}/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "xc-token", "value": "={{ $env.NOCODB_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_name\": \"WF-10 Facebook Publishing\",\n  \"event_type\": \"facebook_publish\",\n  \"status\": $json.status,\n  \"result\": { \"platform_post_id\": $json.platform_post_id, \"url\": $json.url, \"skip_reason\": $json.__reason }\n}",
        "options": {}
      },
      "id": "1b7c9ade-0006-4a3b-9c1d-000000000b06",
      "name": "Log Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": $json.status,\n  \"platform_post_id\": $json.platform_post_id,\n  \"url\": $json.url,\n  \"skipped\": $json.__skip || false,\n  \"reason\": $json.__reason || null\n}",
        "options": {}
      },
      "id": "1b7c9ade-0007-4a3b-9c1d-000000000b07",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "FB Publish Webhook": {
      "main": [[{ "node": "Approval Gate", "type": "main", "index": 0 }]]
    },
    "Approval Gate": {
      "main": [[{ "node": "FB Create Post", "type": "main", "index": 0 }]]
    },
    "FB Create Post": {
      "main": [[{ "node": "Capture Result", "type": "main", "index": 0 }]]
    },
    "Capture Result": {
      "main": [[{ "node": "Save SocialPost", "type": "main", "index": 0 }]]
    },
    "Save SocialPost": {
      "main": [[{ "node": "Log Publish", "type": "main", "index": 0 }]]
    },
    "Log Publish": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false },
  "active": false
}

{
  "name": "Lead Ingest (normalize + dedupe + NocoDB)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-ingest",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "10000000-0000-4000-8000-000000000001",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-640, 0]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ? $input.first().json.body : $input.first().json;\nconst raw = String(b.mobile || b.phone || '').replace(/\\D/g, '');\nlet mobile = raw;\nif (mobile.length === 10) mobile = '91' + mobile;\nelse if (mobile.length === 11 && mobile.startsWith('0')) mobile = '91' + mobile.slice(1);\nconst now = new Date().toISOString();\nconst leadId = 'L-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8);\nreturn [{ json: {\n  LeadId: leadId,\n  DedupeKey: mobile,\n  Name: String(b.name || '').trim(),\n  Mobile: mobile,\n  Email: String(b.email || '').trim(),\n  City: String(b.city || 'Tirupati').trim(),\n  Source: String(b.source || 'website').trim(),\n  Type: String(b.type || 'consultation').trim(),\n  FinancialGoal: String(b.financial_goal || b.goal || '').trim(),\n  Message: String(b.message || '').trim(),\n  Status: 'new',\n  Priority: (b.type === 'insurance' || b.type === 'sip') ? 'high' : 'medium',\n  FollowUpDate: null,\n  Notes: '',\n  Outcome: '',\n  OptedOut: false,\n  CreatedAt: now\n} }];"
      },
      "id": "10000000-0000-4000-8000-000000000002",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [-420, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NOCODB_URL }}/api/v2/meta/tables/{{ $env.LEADS_TABLE_ID }}/records?where=(DedupeKey,eq,{{ $('Normalize Lead').first().json.DedupeKey }})&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "genericAuthCredential": {
          "__rl": true,
          "value": "NocoDB API Token",
          "mode": "list",
          "cachedResultName": "NocoDB API Token"
        },
        "options": {}
      },
      "id": "10000000-0000-4000-8000-000000000003",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "dup-cond-1",
              "leftValue": "={{ $json.list.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "10000000-0000-4000-8000-000000000004",
      "name": "Duplicate Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [20, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOCODB_URL }}/api/v2/meta/tables/{{ $env.LEADS_TABLE_ID }}/records",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ LeadId: $('Normalize Lead').first().json.LeadId, DedupeKey: $('Normalize Lead').first().json.DedupeKey, Name: $('Normalize Lead').first().json.Name, Mobile: $('Normalize Lead').first().json.Mobile, Email: $('Normalize Lead').first().json.Email, City: $('Normalize Lead').first().json.City, Source: $('Normalize Lead').first().json.Source, Type: $('Normalize Lead').first().json.Type, FinancialGoal: $('Normalize Lead').first().json.FinancialGoal, Message: $('Normalize Lead').first().json.Message, Status: $('Normalize Lead').first().json.Status, Priority: $('Normalize Lead').first().json.Priority, OptedOut: $('Normalize Lead').first().json.OptedOut, CreatedAt: $('Normalize Lead').first().json.CreatedAt }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "genericAuthCredential": {
          "__rl": true,
          "value": "NocoDB API Token",
          "mode": "list",
          "cachedResultName": "NocoDB API Token"
        },
        "options": {}
      },
      "id": "10000000-0000-4000-8000-000000000005",
      "name": "Create Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, -160]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.NOCODB_URL }}/api/v2/meta/tables/{{ $env.LEADS_TABLE_ID }}/records",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ Id: $json.list[0].Id, Notes: ($json.list[0].Notes || '') + '\\n[repeat submission ' + new Date().toISOString() + '] ' + $('Normalize Lead').first().json.Message }]) }}",
        "authentication": "genericCredentialType",

# =====================================================================
# Fortune U Group Master AI Agent — environment configuration
# Copy this file to `automation/.env` (or export these vars) and fill in
# real values. NEVER commit `.env`. Secrets are loaded from the environment
# only and are never hard-coded, logged or exposed.
#
# BLOCKED integrations (empty here) still run the system in local/dry-run
# mode so the whole pipeline stays testable without credentials.
# =====================================================================

# ---- Behaviour flags ----------------------------------------------------
# Enable automatic publishing (overrides the approval gate). Keep false.
AUTO_PUBLISH=false
# Dry-run: simulate outbound sends without transmitting anything. Keep true.
FUG_DRY_RUN=true
# Max follow-up attempts per lead.
MAX_FOLLOWUPS=3
# Days of inactivity after which a lead is marked inactive.
INACTIVITY_DAYS=14

# ---- Storage -------------------------------------------------------------
# Directory for the built-in JSON store (fallback when NocoDB is absent).
FUG_DATA_DIR=./data
# Root of the static website for the SEO agent's read-only audit.
FUG_SITE_ROOT=/home/user/fortuneugroup-website

# ---- NocoDB (CRM / data layer) -------------------------------------------
NOCODB_URL=
NOCODB_API_TOKEN=
NOCODB_DB_NAME=fug_crm

# ---- WhatsApp Cloud API ---------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=

# ---- Meta Graph API (Instagram / Facebook) --------------------------------
META_ACCESS_TOKEN=
FB_PAGE_ID=
IG_USER_ID=

# ---- YouTube Data API / OAuth ----------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=

# ---- LLM (Gemini) ----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Intake webhook ---------------------------------------------------------
# Optional secret required in the `X-Intake-Secret` header.
INTAKE_SECRET=
FUG_INTAKE_PORT=8080

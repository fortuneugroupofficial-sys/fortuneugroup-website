# ============================================================================
# Fortune U Group — automation stack environment (EXAMPLE ONLY — copy to .env)
# ============================================================================
# .env is git-ignored. Fill real values on the server. Never commit this file
# with real secrets.

# --- Postgres / shared DB ---------------------------------------------------
POSTGRES_USER=nocodb
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nocodb
N8N_DB=n8n

# --- Domains ----------------------------------------------------------------
N8N_DOMAIN=n8n.fortuneugroup.in
CRM_DOMAIN=crm.fortuneugroup.in
NOCODB_PUBLIC_URL=https://crm.fortuneugroup.in
N8N_EDITOR_BASE_URL=https://n8n.fortuneugroup.in
WEBHOOK_URL=https://n8n.fortuneugroup.in
N8N_PROTOCOL=https
N8N_HOST=0.0.0.0

# --- n8n basic auth (editor login) ------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=CHANGE_ME_ADMIN
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Inbound webhook auth (shared secret) ------------------------------------
FUG_WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING

# --- NocoDB ------------------------------------------------------------------
NOCODB_URL=http://nocodb:8080
NOCODB_API_TOKEN=

# --- WhatsApp Cloud API ------------------------------------------------------
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=

# --- Meta Graph API (Facebook + Instagram) -----------------------------------
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_ACCOUNT_ID=

# --- LLM ---------------------------------------------------------------------
GEMINI_API_KEY=
# optional OpenAI-compatible alternative:
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# --- YouTube Data API (OAuth) -------------------------------------------------
# Note: OAuth is managed via n8n credentials (Settings -> Credentials), not env.
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
